
# GenAI provider configuration
# Copy this file to .env and replace the placeholder values.
# Never commit your .env file or expose API keys publicly.

# --------------------------------------------------
# Groq / OpenAI-compatible API (primary provider)
# --------------------------------------------------
BASE_URL=https://api.groq.com/openai/v1
API_KEY=your_groq_api_key_here
MODEL=openai/gpt-oss-20b


# --------------------------------------------------
# Ollama - Local LLM
# --------------------------------------------------
# Use these values when running a model locally with Ollama.
# --- Ollama fallback (local, private). Uncomment these three, comment the three above. ---
# BASE_URL=http://localhost:11434/v1
# API_KEY=ollama
# MODEL=llama3.2:3b


# --------------------------------------------------
# Google Gemini (second provider)
# --------------------------------------------------
# Leave blank to auto-detect the current Flash model; or pin one after running
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash


# --------------------------------------------------
# Vision-Language Model
# --------------------------------------------------
#  Leave blank to auto-detect what your provider offers. ---
VISION_MODEL="qwen/qwen3.8-27b"