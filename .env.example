# Copy this file to .env and paste your key. .env is git-ignored and never uploaded.
# Never put a key in chat, code, or a screenshot.

# --- Groq (default for the course) ---
BASE_URL=https://api.groq.com/openai/v1
API_KEY=paste_your_groq_key_here
MODEL=openai/gpt-oss-20b          # pinned for the batch; the instructor changes this, not you

# --- Ollama fallback (local, private). Uncomment these three, comment the three above. ---
# BASE_URL=http://localhost:11434/v1
# API_KEY=ollama
# MODEL=llama3.2:3b


# --- Gemini (second provider, Session 11) ---
# Free key: aistudio.google.com -> Get API key. No card needed.
GEMINI_API_KEY=paste_your_gemini_key_here
# Leave blank to auto-detect the current Flash model; or pin one after running
# list_gemini_models() in the Session 11 notebook.
GEMINI_MODEL=gemini-3.8-flash